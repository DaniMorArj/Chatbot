# Copia este fichero a .env y rellena los valores. .env está en .gitignore.

# Puerto del servicio
PORT=3100

# Conexión a PostgreSQL. En local apunta al contenedor Docker de Postgres (ver README).
# En producción, la cadena de conexión de tu base de datos gestionada.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/store_support

# Acceso al panel interno (/panel). Autenticación básica usuario/contraseña.
# Si dejas PANEL_PASSWORD vacío, el panel queda ABIERTO (solo para desarrollo).
PANEL_USER=oficina
PANEL_PASSWORD=cambia-esta-contraseña

# Token del endpoint MCP (/mcp). El cliente debe enviar Authorization: Bearer <este-token>.
# Si lo dejas vacío, /mcp queda ABIERTO (solo para desarrollo).
MCP_TOKEN=cambia-este-token-mcp

# Zona horaria para las fechas del panel (por defecto Europe/Madrid)
TZ_PANEL=Europe/Madrid

# Orígenes autorizados a embeber el chat como widget (cabecera CSP frame-ancestors).
# Por defecto solo el propio sitio. Para permitir otras webs:
# EMBED_FRAME_ANCESTORS='self' https://*.tu-dominio.com
